FROM alpine:3.22
RUN apk add --no-cache openssh-client
ENV SSH_AUTH_SOCK=/ssh-agent
CMD ["ssh", "-N", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", "-o", "PubkeyAuthentication=unbound", "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=3", "-L", "0.0.0.0:11434:127.0.0.1:11434", "zeb@10.25.1.1"]

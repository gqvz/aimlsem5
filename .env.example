# Complete OpenAI-compatible endpoint and model. Clear both for local demo mode.
# Android Settings > AI model can override URL/name for that device.
LLM_API_URL=https://opencode.ai/zen/v1/chat/completions
LLM_MODEL=space-bunny-free
# Supply an externally authorized provider key if required. OpenCode may restrict
# free-tier requests made outside its own client; the app's connection test reports it.
LLM_API_KEY=
LLM_TIMEOUT=120
# STT_API_URL=https://your-provider/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-1
# TTS_API_URL=https://your-provider/audio/speech
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# Optional private Docker SSH bridge (compose.gemma.yaml):
# This explicitly selects remote Gemma instead of the settings above.
# SAHAY_SSH_AGENT=/path/from/echo-SSH_AUTH_SOCK
# LLM_API_URL=http://model-tunnel:11434/v1/chat/completions

%% Page 4 of 8: backend request security and access control
flowchart TB
    Prev["From page 3: Android app<br/>Also serves the legacy web prototype"]
    subgraph Gate["Request security layer"]
        direction TB
        Edge["<b>Network edge</b><br/>Host port 127.0.0.1:8000<br/>ThreadingHTTPServer"]
        Filter["<b>Request filtering</b><br/>POST route allowlist<br/>16 KB limit, 15 MB care + speech<br/>JSON object validation"]
        Response["<b>Response hardening</b><br/>no-store, nosniff headers<br/>Request logging disabled<br/>Generic 500 errors"]
    end
    subgraph Auth["Access control layer"]
        direction TB
        Cred["<b>Authentication</b><br/>Salted scrypt passwords<br/>Constant-time comparison<br/>Hashed tokens + invite codes"]
        Sess["<b>Session lifecycle</b><br/>12-hour expiry<br/>7-day invitations<br/>Revoked on password change<br/>and deactivation"]
        RBAC["<b>Authorization</b><br/>Role check in each handler<br/>Record ownership<br/>Thread membership<br/>Active partner check<br/>Admin blocked from care API"]
    end
    Next["Continues on page 5: accounts, shares, care"]
    Guest["Continues on page 5: assistant + speech<br/>Guest access, no token required"]
    Prev ==> Gate
    Gate --> Auth
    Auth --> Next
    Gate -->|"Guest allowed"| Guest


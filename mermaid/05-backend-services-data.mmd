        Care["<b>Care communication</b><br/>Threads, notes, requests<br/>Transactional fulfilment<br/>Authenticated downloads"]
        Speech["<b>Speech adapters</b><br/>STT to 8 MB, TTS to MP3<br/>503 when unconfigured"]

%% Page 7 of 8: agentic AI specialists, output guardrails and response
flowchart TB
    Prev["From page 6: Supervisor action"]
    subgraph Spec["Specialist agent layer"]
        direction TB
        Emotional["<b>Emotional support</b><br/>Short reflective reply"]
        Knowledge["<b>Knowledge</b><br/>Cited curated source cards"]
        Visit["<b>Visit preparation</b><br/>Questions, editable brief<br/>Never sends anything"]
        Activity["<b>Activity</b><br/>1 to 3 catalogue IDs<br/>Fixed grounding for coping"]
    end
    subgraph Out["Output guardrail layer"]
        direction TB
        Review["<b>Review agent</b><br/>Fidelity, urgency, negation<br/>Approve or veto"]
        Check["<b>Deterministic check</b><br/>Forbidden claims + advice<br/>URL allowlist, length limits"]
        Fixed["<b>Fixed localized replies</b><br/>Help, boundary, clarification<br/>Fallback on veto or failure"]
        Catalogue["<b>Catalogue validation</b><br/>Known IDs, energy fit,<br/>stated constraints"]
    end
    subgraph Contract["Response + state layer"]
        direction TB
        State["<b>Request-scoped State</b><br/>No durable memory or trace store<br/>No emotional profile"]
        Trace["<b>Response contract</b><br/>route, action, text, card, mode<br/>activity_plan, visit_brief, suggestions<br/>Public agent_trace"]
    end
    Prev --> Spec
    Emotional --> Review
    Knowledge --> Review
    Visit --> Review
    Activity --> Catalogue
    Review --> Check
    Check -->|"Veto or failure"| Fixed
    Check -->|"Approved"| Contract
    Catalogue -->|"Valid plan"| Contract
    Fixed --> Contract

    classDef semantic fill:#E8F1FB,stroke:#3B6FA5,color:#14304D
    classDef security fill:#FBE9E7,stroke:#B3452F,color:#5A1D10
    classDef data fill:#E9F5EC,stroke:#3F8153,color:#163D22
    classDef external fill:#F0EEF6,stroke:#6B5F92,color:#2C2545,stroke-dasharray:5 3
    classDef ref fill:#FFF8E1,stroke:#A07F1F,color:#4A3A0C
    class Emotional,Knowledge,Visit,Activity,State,Trace semantic
    class Review,Check,Catalogue,Fixed security
    class Prev ref
